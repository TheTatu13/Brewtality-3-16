{
  "userAgent": "job_seeker_ro_spider",
  "requestTimeoutMs": 10000,
  "pageDelayMs": 1000,
  "staleJobDeletion": false,
  "manageCompany": false,
  "defaultLocation": ["Iași"],
  "defaultWorkmode": "on-site",
  "ownJobUrlPrefix": "https://www.antibiotice.ro/joburi/",
  "sources": {
    "sitemap": "https://www.antibiotice.ro/joburi-sitemap.xml",
    "listing": "https://www.antibiotice.ro/cariere/open-position/",
    "jobArchive": "https://www.antibiotice.ro/joburi/"
  },
  "selectors": {
    "jobArticle": [
      "article.job-item",
      "[class*='job-item']",
      ".career-item, .job-listing, li.job, .vacancy"
    ],
    "jobTitle": [
      ".header-job h3",
      "h1, h2, h3, h4",
      ".job-title, [class*='title']",
      "[itemprop='title'], [aria-label]",
      "a[href*='/joburi/']"
    ],
    "jobMeta": [
      "article.job-item > p",
      ".job-item p, .career-item p",
      "p, .meta, [class*='deadline'], [class*='data']"
    ]
  }
}
